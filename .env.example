# Copy to .env.local for local development. Vite only exposes variables
# prefixed with VITE_, and it BAKES THEM IN AT BUILD TIME — they are not read
# at runtime. In Coolify each of these must be marked "Is Build Variable? = ON",
# otherwise the built bundle contains `undefined`.

# Backend API base URL (no trailing slash, no /api/v1 suffix).
# Local development: http://localhost:8085
VITE_API_URL=https://api.rabhanaa.com

# Firebase Cloud Messaging — web push.
# Optional: with these unset the app runs normally and push is skipped.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Facebook Pixel ID for ad tracking.
# Optional: unset means the pixel never loads. Not a secret — it is visible in
# the page source of any visitor, so it does not need Coolify's secret flag.
VITE_FB_PIXEL_ID=
